'{{candidate.config_name}}'
$
 {{candidate.incr_freq}} {{candidate.start_freq}} {{candidate.nb_freq}}  {{candidate.nb_angle_section}} 0.
$
   F T T T T T
$
{{candidate.global_time_step}} {{candidate.spatial_time_step}} {{candidate.spectral_time_step}} {{candidate.source_time_step}}
$
$ Input and dissipation with saturation-based dissipation
$ 
$TEST451
$ Wind
&SIN4 ZWND = 10.0, ALPHA0 = 0.00950, Z0MAX = 1.00200, BETAMAX = 1.52000,
SINTHP = 2.00000, ZALP = 0.00600, TAUWSHELTER = 1.00000, SWELLFPAR = 1,
SWELLF = 0.80000, SWELLF2 =-0.01800, SWELLF3 = 0.01500, SWELLF4 = 100000.0,
SWELLF5 = 1.20000, SWELLF6 = 0.00000, SWELLF7 =   230000.00, Z0RAT = 0.04000 /
$ Dissipation
&SDS4 WNMEANP = 0.50, WNMEANPTAIL= 0.50,FXFM3 =9.9,SDSC1 =  0.0000E+00,
SDSC2 = -0.2200E-04,SDSBCK =  0.0000E+00,SDSHCK = 0,SDSDTH = 80.0,
SDSBR =   0.9E-03,SDSCUM = -0.40344,SDSCOS =2.0,SDSC4 =  1.00, SDSP = 2.00,
SDSC5 =  0.0000E+00, SDSC6 =  0.3000E+00 /
&SNL1 NLPROP = 2.5E7 /
$
