#
# Environment variables for wavewatch III
# ---------------------------------------
#
 
WWATCH3_LPR      printer
WWATCH3_F77      {{ candidate.compiler_F77_command }}
WWATCH3_CC       {{ candidate.compiler_CC_command }}
WWATCH3_DIR      {{ candidate.model_dir }}
WWATCH3_TMP      {{ candidate.tmp_dir }}
WWATCH3_SOURCE   yes
WWATCH3_LIST     yes
 
